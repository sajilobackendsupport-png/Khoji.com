rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'sajilobackendsupport@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    // Health probe rule
    match /test/{docId} {
      allow read, write: if true;
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Emergency Records ---
    match /emergencies/{emergencyId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

